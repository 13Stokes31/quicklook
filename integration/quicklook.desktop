[Desktop Entry]
Type=Application
Name=Quick Look
Icon=image-x-generic
MimeType=image/jpeg;image/png;image/webp;image/gif;image/bmp;image/tiff;image/x-icon;image/vnd.microsoft.icon;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-portable-anymap;image/x-tga;image/x-exr;image/qoi;
Exec=quicklook %f
Actions=quicklookPreview;
TryExec=quicklook
X-KDE-Protocols=file
X-KDE-RequiredNumberOfUrls=1
X-KDE-Priority=TopLevel

[Desktop Action quicklookPreview]
Name=Preview with Quick Look
Name[es]=Vista previa con Quick Look
Icon=image-x-generic
Exec=quicklook %f
